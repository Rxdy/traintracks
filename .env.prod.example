# Modèle du .env de PRODUCTION (sur le Pi : /home/rudya/traintracks/.env). Le vrai fichier n'est jamais committé.
# Le vrai jeu de valeurs (avec mots de passe générés) est dans .env.prod en local, à copier sur le Pi puis à ranger dans Bitwarden.

# --- Application ---
APP_URL=https://traintracks.rxdy.fr
# TAG=v1.0.0            # facultatif : fige une version au lieu de « latest »

# --- Base de données ---
POSTGRES_PASSWORD=
# --- Signature des exports de données (ne plus la changer ensuite) ---
EXPORT_SECRET=

# --- E-mail (Zimbra OVH) ---
SMTP_URL=smtps://rudy%40rxdy.fr:MOT_DE_PASSE_ENCODE@smtp.mail.ovh.net:465
MAIL_FROM=Train Tracks <traintracks@rxdy.fr>

# --- Connexion avec Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mentions légales ---
LEGAL_NAME=
LEGAL_CONTACT=
LEGAL_HOST=
