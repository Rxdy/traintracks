# Copier en .env (jamais committé). Valeurs de développement par défaut si absent.
POSTGRES_PASSWORD=change-moi
APP_URL=http://localhost:8090
# SMTP_URL=smtp://user:pass@smtp.exemple.fr:587
FRONT_PORT=8090
# Clé qui signe les fichiers d'export de données (une longue chaîne aléatoire ; ne la change plus ensuite : les anciens exports deviendraient invalides)
EXPORT_SECRET=
# Mentions légales (affichées dans l'application)
LEGAL_NAME=
LEGAL_CONTACT=
LEGAL_HOST=
